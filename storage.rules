rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat attachments - allow authenticated users to read/write
    match /chat/{conversationId}/attachments/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Task attachments - allow authenticated users to read/write
    match /tasks/{taskId}/attachments/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Expense receipts - allow authenticated users to read/write
    match /expenses/{expenseId}/receipts/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

